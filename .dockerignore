# Исключаем служебные файлы Git и секреты
.git
.gitignore
.dockerignore
.env

# Исключаем учебную литературу (ей нечего делать внутри контейнера)
books/

# Исключаем локальные логи и результаты (они пробрасываются динамически)
outputs/
wandb/
.pytest_cache/

# Исключаем тяжелые веса моделей и колеса сборки
checkpoints/
*.pt
*.whl
